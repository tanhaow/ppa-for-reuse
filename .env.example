# Database Configuration
DB_NAME=ppa
DB_USER=ppa
DB_PASSWORD=ppa
DB_HOST=localhost
DB_PORT=5432

# Solr Configuration
SOLR_URL=http://localhost:8983/solr/
SOLR_COLLECTION=ppa
SOLR_CONFIGSET=ppa

# Adapter Configuration
# Set to use a specific adapter (e.g., 'cookbook' for the cookbook example)
ARCHIVE_ADAPTER=cookbook
ADAPTERS_DIR=./examples/adapters

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Data Import Paths
# Uncomment and configure these if you plan to import data from these sources

# HathiTrust data path
# HATHI_DATA=/path/to/hathi/data

# Gale API credentials
# GALE_API_USERNAME=your-username

# MARC data path (required for Gale/ECCO import)
# MARC_DATA=/path/to/marc/data

# Gale local OCR data path
# GALE_LOCAL_OCR=/path/to/gale/ocr

# EEBO-TCP data path
# EEBO_DATA=/path/to/eebo/data

# Optional: Email Configuration
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-password

# Optional: Analytics
# GTAGS_ANALYTICS_ID=UA-property-id
# PLAUSIBLE_ANALYTICS_SCRIPT=https://plausible.io/js/script.js
